# Copy to `.env` on the SERVER only (or set these in your deployment platform).
# NEVER put real keys in this file: it is committed to git. Placeholders only.
#
# ---- WooCommerce -------------------------------------------------------------
# Your store URL (https). If WordPress runs on this same machine, use
# http(s)://host.docker.internal or your LAN IP — NOT localhost (that's the container).
WC_URL=https://your-store.com

# WooCommerce > Settings > Advanced > REST API > Add key  (Permissions: Read)
WC_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WC_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WC_VERIFY_SSL=true

# Leave empty to auto-detect (/sitemap_index.xml, /wp-sitemap.xml, /sitemap.xml)
SITEMAP_URL=
# Headless / separate storefront (e.g. Next.js shop on another domain): the domain customers
# shop on. Used for product links and as a fallback page list. Leave empty for normal WooCommerce.
STOREFRONT_URL=

# ---- Sync --------------------------------------------------------------------
CRAWL_KINDS=page,post            # which sitemap sections to read for FAQ answers
CRAWL_MAX_PAGES=300
SYNC_INTERVAL_SECONDS=21600      # auto-sync every 6 hours

# ---- Orders / returns --------------------------------------------------------
RETURN_WINDOW_DAYS=30
MAX_ORDER_VERIFY_ATTEMPTS=3
# Order meta key(s) where your delivery-date plugin stores the date (comma separated)
DELIVERY_DATE_META_KEYS=_delivery_date,delivery_date,_orddd_timestamp,_orddd_lite_timestamp,jckwds_date,_jckwds_date

# Minimum relevance score before the bot answers from a page snippet
PAGE_ANSWER_MIN_SCORE=1.5

# ---- Chatwoot (optional) -----------------------------------------------------
# Chatwoot > Settings > Bots > Add bot. Webhook URL: https://<your-rasa-domain>/chatwoot/webhook
CHATWOOT_URL=https://chat.your-store.com
CHATWOOT_BOT_TOKEN=
# Webhook secret shown on the bot page (newer Chatwoot versions). Leave empty if your version has none,
# and instead set CHATWOOT_URL_TOKEN to a long random string and add ?token=<it> to the webhook URL.
CHATWOOT_WEBHOOK_SECRET=
CHATWOOT_URL_TOKEN=
